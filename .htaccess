Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^qa-training/?$ /qa-training.html [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^(assets|prt-assets-v6)/ - [R=404,L]
RewriteRule ^(about|services|contact|get-started)/?$ $1/index.html [L]
RewriteRule ^ /404.html [L]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(html|js)$">
Header set Cache-Control "no-cache, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>
